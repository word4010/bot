TOKEN=your_discord_bot_token
CLIENT_ID=your_application_id
OWNER_ID=your_discord_user_id
GUILD_ID=
# Required to enable the owner-only web dashboard. Use a long unique password.
DASHBOARD_PASSWORD=replace_with_a_long_random_password
PORT=3000
# Якщо хостинг надає SERVER_PORT, код використає його автоматично.

# GitHub Pages origin, e.g. https://USERNAME.github.io/REPOSITORY
DASHBOARD_ORIGIN=https://YOUR-USERNAME.github.io
# Optional independent signing secret (use a long random value)
DASHBOARD_SECRET=replace_with_a_long_random_secret
